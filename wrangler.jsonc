// Cloudflare settings for The Scenic Inn website + backend.
// The website files are served as they are; anything under /api goes to worker.js.
{
  "name": "scenic-inn",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // The database is created automatically on the first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "scenic-inn" }
  ],
  "observability": { "enabled": true }
}
